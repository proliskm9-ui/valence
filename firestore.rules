rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{leadId} {
      // Создать заявку может кто угодно, но только валидной формы
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'contact', 'message', 'budget', 'createdAt', 'status'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 200
        && request.resource.data.contact is string
        && request.resource.data.contact.size() >= 5
        && request.resource.data.contact.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && (request.resource.data.budget == null
            || (request.resource.data.budget is string
                && request.resource.data.budget.size() <= 100))
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      // Читать / менять статус — только через сервер админки (Firebase Auth сессия)
      allow read: if request.auth != null;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'in_progress', 'closed'];

      allow delete: if false;
    }
  }
}
